// Stock Xiaomi 64-bit gralloc libs. The source libgralloccore/libgrallocutils
// cause a one-frame red border around the screen when the FOD HBM overlay
// appears (fingerprint unlock). 32-bit stays source-built.
cc_prebuilt_library_shared {
    name: "libgralloccore",
    owner: "xiaomi",
    vendor: true,
    prefer: true,
    check_elf_files: false,
    strip: { none: true },
    compile_multilib: "64",
    arch: { arm64: { srcs: ["common/proprietary/vendor/lib64/libgralloccore.so"] } },
}

cc_prebuilt_library_shared {
    name: "libgrallocutils",
    owner: "xiaomi",
    vendor: true,
    prefer: true,
    check_elf_files: false,
    strip: { none: true },
    compile_multilib: "64",
    arch: { arm64: { srcs: ["common/proprietary/vendor/lib64/libgrallocutils.so"] } },
}

// AOSP external (USB) camera provider, 64-bit, built from source on 10-31 against
// the AOSP device impls (same binary the ROM shipped before the dedupe). Needed by
// the stock provider@2.4-impl. Prebuilt because it can't compile against the stock
// device prebuilts (they don't export the AOSP headers). 32-bit stays source-built.
cc_prebuilt_library_shared {
    name: "android.hardware.camera.provider@2.4-external",
    owner: "xiaomi",
    vendor: true,
    prefer: true,
    check_elf_files: false,
    strip: { none: true },
    compile_multilib: "64",
    arch: { arm64: { srcs: ["common/proprietary/vendor/lib64/android.hardware.camera.provider@2.4-external.so"] } },
}

// Stock Xiaomi audio HAL under its original name. sound_trigger.primary.kona
// builds "audio.primary.<ro.board.platform>.so" and fails if the HAL is renamed.
cc_prebuilt_library_shared {
    name: "audio.primary.kona",
    owner: "xiaomi",
    vendor: true,
    prefer: true,
    check_elf_files: false,
    strip: { none: true },
    relative_install_path: "hw",
    compile_multilib: "both",
    arch: {
        arm: { srcs: ["common/proprietary/vendor/lib/hw/audio.primary.kona.so"] },
        arm64: { srcs: ["common/proprietary/vendor/lib64/hw/audio.primary.kona.so"] },
    },
}
