// Stock Xiaomi camera provider/device HALs. These replace the AOSP source
// modules of the same name (prefer: true). The AOSP device layer breaks MIUI
// front video (SelfieEIS GPU node fails to import encoder buffers: mmap EINVAL).
// Kept outside a soong_namespace so prebuilt replacement can see the source modules.

cc_prebuilt_library_shared {
    name: "android.hardware.camera.provider@2.4-impl",
    owner: "xiaomi",
    vendor: true,
    prefer: true,
    check_elf_files: false,
    strip: { none: true },
    relative_install_path: "hw",
    compile_multilib: "both",
    arch: {
        arm64: { srcs: ["common/proprietary/vendor/lib64/hw/android.hardware.camera.provider@2.4-impl.so"] },
        arm: { srcs: ["common/proprietary/vendor/lib/hw/android.hardware.camera.provider@2.4-impl.so"] },
    },
}

cc_prebuilt_library_shared {
    name: "android.hardware.camera.provider@2.4-legacy",
    owner: "xiaomi",
    vendor: true,
    prefer: true,
    check_elf_files: false,
    strip: { none: true },
    compile_multilib: "both",
    arch: {
        arm64: { srcs: ["common/proprietary/vendor/lib64/android.hardware.camera.provider@2.4-legacy.so"] },
        arm: { srcs: ["common/proprietary/vendor/lib/android.hardware.camera.provider@2.4-legacy.so"] },
    },
}

